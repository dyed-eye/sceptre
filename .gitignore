# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local interpreter pin (this is a library, requires-python >= 3.11; committing a
# specific dev pin would force contributors' venvs onto one version)
.python-version

# Tool caches / generated reports
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Example plots: regenerable locally with `uv run python examples/*.py` (unlike
# comsol/output, which needs a licensed COMSOL and is therefore tracked evidence)
examples/output/

# COMSOL validation artifacts (top-level comsol/ only -- the bridge code in
# src/sceptre/comsol/ is part of the package): internal use, not distributed.
# Regenerable via scripts/run_comsol_validation.py on a machine with COMSOL.
/comsol/
*.log

# JVM crash dumps (COMSOL/JPype)
hs_err_pid*.log
replay_pid*.log

# The above is fixed in initial commit, the rest comes implicit to git for a clear record
.gitignore
VALIDATION.md
